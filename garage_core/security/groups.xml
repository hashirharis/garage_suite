<odoo>
    <record id="module_category_garage" model="ir.module.category">
        <field name="name">Garage Suite</field>
        <field name="sequence">30</field>
    </record>
    <record id="privilege_garage" model="res.groups.privilege">
        <field name="name">Garage Suite</field>
        <field name="category_id" ref="module_category_garage" />
    </record>
    <record id="group_garage_staff" model="res.groups">
        <field name="name">Workshop Reader</field>
        <field name="privilege_id" ref="privilege_garage" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="group_garage_user" model="res.groups">
        <field name="name">Reception / Service Advisor</field>
        <field name="privilege_id" ref="privilege_garage" />
        <field name="implied_ids" eval="[(4, ref('group_garage_staff'))]" />
    </record>
    <record id="group_garage_receptionist" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="privilege_id" ref="privilege_garage" />
        <field name="implied_ids" eval="[(6, 0, [ref('group_garage_staff')])]" />
    </record>
    <record id="group_garage_advisor" model="res.groups">
        <field name="name">Service Advisor</field>
        <field name="privilege_id" ref="privilege_garage" />
        <field name="implied_ids" eval="[(4, ref('group_garage_user'))]" />
    </record>
    <record id="group_garage_technician" model="res.groups">
        <field name="name">Technician</field>
        <field name="privilege_id" ref="privilege_garage" />
        <field name="implied_ids" eval="[(4, ref('group_garage_staff'))]" />
    </record>
    <record id="group_garage_quality" model="res.groups">
        <field name="name">Quality Inspector</field>
        <field name="privilege_id" ref="privilege_garage" />
        <field name="implied_ids" eval="[(4, ref('group_garage_staff'))]" />
    </record>
    <record id="group_garage_storekeeper" model="res.groups">
        <field name="name">Parts Storekeeper</field>
        <field name="privilege_id" ref="privilege_garage" />
        <field name="implied_ids" eval="[(4, ref('group_garage_staff'))]" />
    </record>
    <record id="group_garage_cashier" model="res.groups">
        <field name="name">Service Cashier</field>
        <field name="privilege_id" ref="privilege_garage" />
        <field name="implied_ids" eval="[(4, ref('group_garage_staff'))]" />
    </record>
    <record id="group_garage_owner" model="res.groups">
        <field name="name">Garage Owner / Reporting</field>
        <field name="privilege_id" ref="privilege_garage" />
        <field name="implied_ids" eval="[(4, ref('group_garage_staff'))]" />
    </record>
    <record id="group_garage_manager" model="res.groups">
        <field name="name">Garage Manager</field>
        <field name="privilege_id" ref="privilege_garage" />
        <field name="implied_ids" eval="[(4, ref('group_garage_advisor')),(4, ref('group_garage_technician')),(4, ref('group_garage_quality')),(4, ref('group_garage_storekeeper')),(4, ref('group_garage_cashier'))]" />
    </record>
</odoo>
<odoo>
    <record id="job_list" model="ir.ui.view">
        <field name="name">garage.job.card.list</field>
        <field name="model">garage.job.card</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'">
                <field name="name" />
                <field name="date" />
                <field name="customer_id" />
                <field name="vehicle_id" />
                <field name="advisor_id" />
                <field name="expected_delivery" />
                <field name="priority" widget="priority" />
                <field name="state" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>
    <record id="job_search" model="ir.ui.view">
        <field name="name">garage.job.card.search</field>
        <field name="model">garage.job.card</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="vehicle_id" />
                <field name="customer_id" />
                <field name="advisor_id" />
                <filter name="active_jobs" string="Active Visits" domain="[('state', 'not in', ['closed', 'cancelled'])]" />
                <filter name="mine" string="My Visits" domain="[('advisor_id', '=', uid)]" />
                <filter name="by_state" string="Status" context="{'group_by': 'state'}" />
            </search>
        </field>
    </record>
    <record id="job_form" model="ir.ui.view">
        <field name="name">garage.job.card.form</field>
        <field name="model">garage.job.card</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_diagnosis" type="object" string="Start Diagnosis" class="oe_highlight" invisible="state != 'draft'" />
                    <button name="action_cancel" type="object" string="Cancel Visit" groups="garage_core.group_garage_manager" invisible="state not in ['draft', 'diagnosing']" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,diagnosing" />
                </header>
                <sheet>
                    <h1>
                        <field name="name" />
                    </h1>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'" />
                            <field name="vehicle_id" readonly="state != 'draft'" />
                            <field name="customer_id" readonly="state != 'draft'" />
                            <field name="odometer" readonly="state != 'draft'" />
                            <field name="odometer_exception_reason" readonly="state != 'draft'" />
                            <field name="registration_at_reception" />
                            <field name="vin_at_reception" />
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="advisor_id" />
                            <field name="technician_ids" widget="many2many_tags" />
                            <field name="service_type" />
                            <field name="expected_delivery" />
                            <field name="priority" widget="priority" />
                            <field name="service_bay" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Reception and Diagnosis">
                            <group>
                                <field name="source" />
                                <field name="previous_job_id" />
                                <field name="fuel_level" />
                                <field name="reception_notes" />
                            </group>
                            <field name="complaint_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field name="observation" />
                                </list>
                            </field>
                            <field name="diagnosis" />
                        </page>
                        <page string="Planned Labour">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field name="technician_ids" widget="many2many_tags" />
                                    <field name="planned_hours" />
                                    <field name="labour_charge" />
                                    <field name="currency_id" column_invisible="True" />
                                </list>
                            </field>
                            <group>
                                <field name="currency_id" invisible="1" />
                                <field name="estimated_hours" />
                                <field name="estimated_cost" />
                            </group>
                        </page>
                        <page string="Cancellation">
                            <field name="cancellation_reason" />
                            <group>
                                <field name="cancelled_by" />
                                <field name="cancelled_at" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="action_jobs" model="ir.actions.act_window">
        <field name="name">Job Cards</field>
        <field name="res_model">garage.job.card</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_jobs': 1}</field>
    </record>
</odoo>
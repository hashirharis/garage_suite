<odoo>
    <record id="vehicle_list" model="ir.ui.view">
        <field name="name">garage.vehicle.list</field>
        <field name="model">garage.vehicle</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="registration_number" />
                <field name="vin" />
                <field name="customer_id" />
                <field name="make" />
                <field name="model" />
                <field name="odometer" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>
    <record id="vehicle_search" model="ir.ui.view">
        <field name="name">garage.vehicle.search</field>
        <field name="model">garage.vehicle</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="registration_number" />
                <field name="vin" />
                <field name="customer_id" filter_domain="['|', ('customer_id', 'ilike', self), ('customer_id.phone', 'ilike', self)]" />
                <filter name="archived" string="Archived" domain="[('active', '=', False)]" />
                <filter name="owner" string="Customer" context="{'group_by': 'customer_id'}" />
            </search>
        </field>
    </record>
    <record id="vehicle_form" model="ir.ui.view">
        <field name="name">garage.vehicle.form</field>
        <field name="model">garage.vehicle</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <h1>
                        <field name="name" />
                    </h1>
                    <group>
                        <group>
                            <field name="active" invisible="1" />
                            <field name="customer_id" context="{'default_is_garage_customer': True}" />
                            <field name="registration_number" />
                            <field name="vin" />
                            <field name="change_reason" />
                            <field name="engine_number" />
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="make" />
                            <field name="model" />
                            <field name="variant" />
                            <field name="category" />
                            <field name="odometer" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Specifications">
                            <group>
                                <group>
                                    <field name="manufacturing_year" />
                                    <field name="registration_year" />
                                    <field name="fuel_type" />
                                    <field name="transmission" />
                                    <field name="engine_capacity" />
                                </group>
                                <group>
                                    <field name="insurance_expiry" />
                                    <field name="pollution_expiry" />
                                    <field name="service_interval_km" />
                                    <field name="service_interval_months" />
                                </group>
                            </group>
                            <field name="notes" />
                        </page>
                        <page string="Service Visits">
                            <field name="job_card_ids" readonly="1" />
                        </page>
                        <page string="Identity and Ownership History">
                            <field name="history_ids" readonly="1">
                                <list>
                                    <field name="changed_at" />
                                    <field name="customer_id" />
                                    <field name="registration_number" />
                                    <field name="vin" />
                                    <field name="reason" />
                                    <field name="actor_id" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="action_vehicles" model="ir.actions.act_window">
        <field name="name">Vehicle Registry</field>
        <field name="res_model">garage.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
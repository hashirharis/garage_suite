    <record id="estimate_workspace" model="ir.ui.view">
        <field name="name">garage.workspace.estimate_workspace</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="garage_workshop.estimate_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[group/field[@name='garage_job_id']]/group" position="attributes">
                <attribute name="string">Consent and evidence</attribute>
            </xpath>
            <xpath expr="//header/field[@name='state' and @widget='statusbar']" position="attributes">
                <attribute name="invisible" add="(garage_job_id)" separator=" or " />
            </xpath>
            <xpath expr="//sheet/notebook" position="before">
                <div class="gs-form-kpis" invisible="not (garage_job_id)">
                    <div class="gs-form-tile">
                        <i class="fa fa-check-square-o" aria-hidden="true" />
                        <div>
                            <span>Customer consent</span>
                            <field name="garage_consent" readonly="1" widget="badge" decoration-success="garage_consent == 'approved'" decoration-warning="garage_consent == 'issued'" decoration-danger="garage_consent == 'rejected'" />
                        </div>
                    </div>
                    <div class="gs-form-tile">
                        <i class="fa fa-files-o" aria-hidden="true" />
                        <div>
                            <span>Revision</span>
                            <field name="garage_version" readonly="1" />
                        </div>
                    </div>
                    <div class="gs-form-tile">
                        <i class="fa fa-calculator" aria-hidden="true" />
                        <div>
                            <span>Total</span>
                            <field name="amount_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" />
                        </div>
                    </div>
                    <div class="gs-form-tile">
                        <i class="fa fa-wrench" aria-hidden="true" />
                        <div>
                            <span>Job card</span>
                            <field name="garage_job_id" readonly="1" />
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    <record id="invoice_workspace" model="ir.ui.view">
        <field name="name">garage.workspace.invoice_workspace</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="garage_service_billing.invoice_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[group/field[@name='garage_job_id']]/group" position="attributes">
                <attribute name="string">Workshop source</attribute>
            </xpath>
            <xpath expr="//header/field[@name='state' and @widget='statusbar']" position="attributes">
                <attribute name="invisible" add="(garage_job_id)" separator=" or " />
            </xpath>
            <xpath expr="//header/field[@name='state' and @widget='account_move_statusbar_secured']" position="attributes">
                <attribute name="invisible" add="garage_job_id" separator=" or " />
            </xpath>
            <xpath expr="//sheet/notebook" position="before">
                <div class="gs-form-kpis" invisible="not (garage_job_id)">
                    <div class="gs-form-tile">
                        <i class="fa fa-file-text-o" aria-hidden="true" />
                        <div>
                            <span>Posting status</span>
                            <field name="state" readonly="1" widget="badge" />
                        </div>
                    </div>
                    <div class="gs-form-tile">
                        <i class="fa fa-credit-card" aria-hidden="true" />
                        <div>
                            <span>Payment status</span>
                            <field name="payment_state" readonly="1" widget="badge" decoration-success="payment_state == 'paid'" decoration-warning="payment_state in ['partial', 'in_payment']" />
                        </div>
                    </div>
                    <div class="gs-form-tile">
                        <i class="fa fa-calculator" aria-hidden="true" />
                        <div>
                            <span>Amount due</span>
                            <field name="amount_residual" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" />
                        </div>
                    </div>
                    <div class="gs-form-tile">
                        <i class="fa fa-wrench" aria-hidden="true" />
                        <div>
                            <span>Job card</span>
                            <field name="garage_job_id" readonly="1" />
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    <record id="crm_workspace" model="ir.ui.view">
        <field name="name">garage.workspace.crm_workspace</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="garage_crm.lead_garage_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[group/field[@name='garage_vehicle_id']]/group" position="attributes">
                <attribute name="string">Vehicle enquiry</attribute>
            </xpath>
            <xpath expr="//header/field[@name='stage_id' and contains(@widget, 'statusbar')]" position="attributes">
                <attribute name="invisible" add="(garage_service_enquiry or garage_vehicle_id or garage_job_ids)" separator=" or " />
            </xpath>
            <xpath expr="//sheet/notebook" position="before">
                <field name="garage_service_enquiry" invisible="1" />
                <div class="gs-form-kpis" invisible="not (garage_service_enquiry or garage_vehicle_id or garage_job_ids)">
                    <div class="gs-form-tile">
                        <i class="fa fa-tasks" aria-hidden="true" />
                        <div>
                            <span>Pipeline stage</span>
                            <field name="stage_id" options="{'no_create': True, 'no_open': True}"
                                   domain="['|', ('team_ids', 'in', team_id), ('team_ids', '=', False)]"
                                   readonly="won_status == 'lost' or not active" />
                        </div>
                    </div>
                    <div class="gs-form-tile">
                        <i class="fa fa-car" aria-hidden="true" />
                        <div>
                            <span>Vehicle</span>
                            <field name="garage_vehicle_id" readonly="1" />
                        </div>
                    </div>
                    <div class="gs-form-tile">
                        <i class="fa fa-wrench" aria-hidden="true" />
                        <div>
                            <span>Service type</span>
                            <field name="garage_service_type_id" readonly="1" />
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    <record id="job_workshop_actions" model="ir.ui.view">
        <field name="name">garage.workspace.job.workflow.actions</field>
        <field name="model">garage.job.card</field>
        <field name="inherit_id" ref="garage_workshop.job_workshop_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_progress']" position="replace">
                <button name="action_progress" type="object" string="Start Work" groups="garage_core.group_garage_technician" invisible="state != 'authorized'" class="oe_highlight" />
                <button name="action_progress" type="object" string="Submit for Quality Check" groups="garage_core.group_garage_technician" invisible="state != 'in_progress'" class="oe_highlight" />
                <button name="action_progress" type="object" string="Resume Work" groups="garage_core.group_garage_technician" invisible="state != 'on_hold'" class="oe_highlight" />
                <button name="action_progress" type="object" string="Mark Ready for Delivery" groups="garage_core.group_garage_quality" invisible="state != 'quality_check'" class="oe_highlight" />
                <button name="action_progress" type="object" string="Record Handover" groups="garage_core.group_garage_user" invisible="state != 'ready'" class="oe_highlight" />
                <button name="action_progress" type="object" string="Close Job Card" groups="garage_core.group_garage_user" invisible="state != 'delivered'" class="oe_highlight" />
            </xpath>
        </field>
    </record>
    <record id="payment_workspace" model="ir.ui.view">
        <field name="name">account.payment.garage.summary</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state' and contains(@widget, 'statusbar')]" position="attributes">
                <attribute name="invisible" add="garage_payment" separator=" or " />
            </xpath>
            <xpath expr="//sheet/group[1]" position="before">
                <field name="garage_payment" invisible="1" />
                <div class="gs-form-kpis" invisible="not garage_payment">
                    <div class="gs-form-tile">
                        <i class="fa fa-credit-card" aria-hidden="true" />
                        <div>
                            <span>Payment status</span>
                            <field name="state" readonly="1" widget="badge" />
                        </div>
                    </div>
                    <div class="gs-form-tile">
                        <i class="fa fa-calculator" aria-hidden="true" />
                        <div>
                            <span>Amount</span>
                            <field name="amount" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" />
                        </div>
                    </div>
                    <div class="gs-form-tile">
                        <i class="fa fa-calendar" aria-hidden="true" />
                        <div>
                            <span>Payment date</span>
                            <field name="date" readonly="1" />
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    <record id="customer_workspace" model="ir.ui.view">
        <field name="name">res.partner.garage.summary</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="garage_core.view_partner_garage" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="before">
                <div class="gs-form-kpis" invisible="not is_garage_customer" groups="garage_core.group_garage_staff">
                    <div class="gs-form-tile">
                        <i class="fa fa-car" aria-hidden="true" />
                        <div>
                            <span>Vehicles</span>
                            <field name="garage_vehicle_count" readonly="1" />
                        </div>
                    </div>
                    <div class="gs-form-tile">
                        <i class="fa fa-wrench" aria-hidden="true" />
                        <div>
                            <span>Service visits</span>
                            <field name="garage_visit_count" readonly="1" />
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

    <record id="garage_job_card_workspace" model="ir.ui.view">
        <field name="name">garage.workspace.garage_job_card_workspace</field>
        <field name="model">garage.job.card</field>
        <field name="inherit_id" ref="garage_core.job_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="gs-workspace-form" separator=" " />
            </xpath>
            <xpath expr="//header/button[1]" position="attributes">
                <attribute name="class" add="btn-primary" separator=" " />
            </xpath>
            <xpath expr="//header/field[@name='state' and contains(@widget, 'statusbar')]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//sheet/group[1]" position="before">
                <div class="gs-form-kpis">
                    <div class="gs-form-tile">
                        <i class="fa fa-wrench" aria-hidden="true" />
                        <div>
                            <span>Visit status</span>
                            <field name="state" readonly="1" widget="badge" decoration-success="state in ['ready', 'delivered', 'closed']" decoration-warning="state in ['awaiting_approval', 'on_hold']" decoration-danger="state == 'cancelled'" decoration-info="state in ['authorized', 'in_progress', 'quality_check']" />
                        </div>
                    </div>
                    <div class="gs-form-tile">
                        <i class="fa fa-clock-o" aria-hidden="true" />
                        <div>
                            <span>Planned labour</span>
                            <field name="estimated_hours" readonly="1" widget="float_time" />
                        </div>
                    </div>
                    <div class="gs-form-tile">
                        <i class="fa fa-tachometer" aria-hidden="true" />
                        <div>
                            <span>Logged labour</span>
                            <field name="actual_hours" readonly="1" widget="float_time" />
                        </div>
                    </div>
                    <div class="gs-form-tile" invisible="not expected_delivery">
                        <i class="fa fa-calendar" aria-hidden="true" />
                        <div>
                            <span>Expected delivery</span>
                            <field name="expected_delivery" readonly="1" />
                        </div>
                    </div>
                </div>
            </xpath>
            <xpath expr="//sheet/group[1]/group[1]" position="attributes">
                <attribute name="string">Vehicle and reception</attribute>
            </xpath>
            <xpath expr="//sheet/group[1]/group[2]" position="attributes">
                <attribute name="string">Workshop assignment</attribute>
            </xpath>
        </field>
    </record>

<odoo>
    <record id="garage_appointment_form" model="ir.ui.view">
        <field name="name">garage.workspace.garage_appointment_form</field>
        <field name="model">garage.appointment</field>
        <field name="inherit_id" ref="garage_workshop.garage_appointment_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="gs-workspace-form" separator=" " />
            </xpath>
            <xpath expr="//sheet/group[1]" position="replace">
                <div class="oe_title">
                    <h1>
                        <field name="name" />
                    </h1>
                </div>
                <group>
                    <group string="Customer and vehicle">
                        <field name="customer_id" />
                        <field name="vehicle_id" />
                        <field name="odometer" />
                    </group>
                    <group string="Schedule">
                        <field name="bay_id" />
                        <field name="start" required="1" />
                        <field name="end" required="1" />
                        <field name="state" />
                    </group>
                    <group string="Visit notes">
                        <field name="complaint" />
                        <field name="change_reason" />
                    </group>
                </group>
            </xpath>
            <xpath expr="//sheet" position="after">
                <chatter />
            </xpath>
            <xpath expr="//sheet/group[1]" position="before">
                <div class="gs-form-kpis">
                    <div class="gs-form-tile">
                        <i class="fa fa-calendar-check-o" aria-hidden="true" />
                        <div>
                            <span>Booking status</span>
                            <field name="state" readonly="1" widget="badge" />
                        </div>
                    </div>
                    <div class="gs-form-tile">
                        <i class="fa fa-clock-o" aria-hidden="true" />
                        <div>
                            <span>Scheduled arrival</span>
                            <field name="start" readonly="1" />
                        </div>
                    </div>
                    <div class="gs-form-tile" invisible="not bay_id">
                        <i class="fa fa-wrench" aria-hidden="true" />
                        <div>
                            <span>Service bay</span>
                            <field name="bay_id" readonly="1" />
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    <record id="garage_inspection_form" model="ir.ui.view">
        <field name="name">garage.workspace.garage_inspection_form</field>
        <field name="model">garage.inspection</field>
        <field name="inherit_id" ref="garage_workshop.garage_inspection_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="gs-workspace-form" separator=" " />
            </xpath>
            <xpath expr="//sheet/group[1]" position="replace">
                <group>
                    <group string="Inspection details">
                        <field name="job_id" />
                        <field name="template_id" />
                        <field name="phase" />
                    </group>
                    <group string="Sign-off">
                        <field name="signed_by" />
                        <field name="signed_at" />
                    </group>
                </group>
            </xpath>
            <xpath expr="//sheet" position="after">
                <chatter />
            </xpath>
            <xpath expr="//sheet/group[1]" position="before">
                <div class="gs-form-kpis">
                    <div class="gs-form-tile">
                        <i class="fa fa-check-square-o" aria-hidden="true" />
                        <div>
                            <span>Inspection status</span>
                            <field name="state" readonly="1" widget="badge" />
                        </div>
                    </div>
                    <div class="gs-form-tile">
                        <i class="fa fa-tasks" aria-hidden="true" />
                        <div>
                            <span>Inspection phase</span>
                            <field name="phase" readonly="1" />
                        </div>
                    </div>
                    <div class="gs-form-tile" invisible="not signed_by">
                        <i class="fa fa-user" aria-hidden="true" />
                        <div>
                            <span>Signed by</span>
                            <field name="signed_by" readonly="1" />
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    <record id="garage_job_time_entry_form" model="ir.ui.view">
        <field name="name">garage.workspace.garage_job_time_entry_form</field>
        <field name="model">garage.job.time.entry</field>
        <field name="inherit_id" ref="garage_workshop.garage_job_time_entry_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="gs-workspace-form" separator=" " />
            </xpath>
            <xpath expr="//sheet/group[1]" position="replace">
                <group>
                    <group string="Assignment">
                        <field name="job_id" />
                        <field name="operation_line_id" domain="[('job_id', '=', job_id)]" />
                        <field name="technician_id" />
                    </group>
                    <group string="Time recorded">
                        <field name="start" required="1" />
                        <field name="end" />
                        <field name="hours" />
                    </group>
                    <group string="Notes">
                        <field name="notes" />
                    </group>
                </group>
            </xpath>
            <xpath expr="//sheet/group[1]" position="before">
                <div class="gs-form-kpis">

    <record id="vehicle_master_form" model="ir.ui.view">
        <field name="name">vehicle.structured.masters</field>
        <field name="model">garage.vehicle</field>
        <field name="inherit_id" ref="garage_core.vehicle_form" />
        <field name="arch" type="xml">
            <field name="make" position="before">
                <field name="make_id" />
                <field name="model_id" domain="[('make_id', '=', make_id)]" />
                <field name="variant_id" domain="[('model_id', '=', model_id)]" />
                <field name="category_id" />
            </field>
        </field>
    </record>
    <record id="job_master_form" model="ir.ui.view">
        <field name="name">job.masters</field>
        <field name="model">garage.job.card</field>
        <field name="inherit_id" ref="garage_core.job_form" />
        <field name="arch" type="xml">
            <field name="service_type" position="after">
                <field name="service_type_id" />
                <field name="bay_id" />
                <field name="package_id" />
            </field>
            <xpath expr="//field[@name='line_ids']/list/field[@name='name']" position="before">
                <field name="operation_id" />
                <field name="product_id" />
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='labour_charge']" position="after">
                <field name="included_in_package" />
            </xpath>
        </field>
    </record>
    <record id="user_skills_form" model="ir.ui.view">
        <field name="name">users.garage.skills</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Workshop" groups="garage_core.group_garage_manager">
                    <group>
                        <field name="garage_skill_ids" widget="many2many_tags" />
                        <field name="garage_hourly_cost" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="product_garage_form" model="ir.ui.view">
        <field name="name">product.garage.configuration</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Workshop">
                    <group>
                        <field name="garage_part" />
                        <field name="garage_service_category_id" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="garage_customer_search" model="ir.ui.view">
        <field name="name">garage.customer.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="phone" />
                <field name="email" />
                <field name="vat" />
                <field name="garage_vehicle_ids" string="Registration / VIN" filter_domain="['|', ('garage_vehicle_ids.registration_number','ilike',self), ('garage_vehicle_ids.vin','ilike',self)]" />
                <filter name="corporate" string="Corporate Customers" domain="[('is_company','=',True)]" />
            </search>
        </field>
    </record>
    <record id="garage_core.action_customers" model="ir.actions.act_window">
        <field name="search_view_id" ref="garage_customer_search" />
    </record>

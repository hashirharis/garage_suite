<odoo>
<record id="job_print" model="ir.actions.report"><field name="name">Job Card</field><field name="model">garage.job.card</field><field name="report_type">qweb-pdf</field><field name="report_name">garage_basic_reports.job_document</field><field name="binding_model_id" ref="garage_core.model_garage_job_card"/></record>
<template id="job_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Job Card <span t-field="o.name"/></h2><div class="row"><div class="col-6"><strong>Customer</strong><div t-field="o.customer_id"/><strong>Vehicle</strong><div t-field="o.vehicle_id"/><div>Registration: <span t-field="o.registration_at_reception"/></div><div>VIN: <span t-field="o.vin_at_reception"/></div></div><div class="col-6"><div>Reception: <span t-field="o.date"/></div><div>Expected delivery: <span t-field="o.expected_delivery"/></div><div>Odometer: <span t-field="o.odometer"/> km</div><div>Advisor: <span t-field="o.advisor_id"/></div><div>Status: <span t-field="o.state"/></div></div></div><h4>Customer Complaints</h4><ul><li t-foreach="o.complaint_ids" t-as="c"><span t-field="c.name"/></li></ul><h4>Diagnosis</h4><p t-field="o.diagnosis"/><h4>Planned Operations</h4><table class="table table-sm"><thead><tr><th>Operation</th><th>Planned hours</th><th>Charge</th></tr></thead><tbody><tr t-foreach="o.line_ids" t-as="line"><td><span t-field="line.name"/></td><td><span t-field="line.planned_hours"/></td><td><span t-field="line.labour_charge"/></td></tr></tbody></table><h4>Inspection Evidence</h4><table class="table table-sm"><tr t-foreach="o.inspection_ids" t-as="i"><td><span t-field="i.template_id"/></td><td><span t-field="i.state"/></td><td><span t-field="i.signed_by"/></td><td><span t-field="i.signed_at"/></td></tr></table><h4>Handover</h4><p t-field="o.delivery_recipient"/><p t-field="o.delivery_acknowledgment"/><p>Delivered: <span t-field="o.delivered_at"/></p><img t-if="o.delivery_signature" t-att-src="image_data_uri(o.delivery_signature)" style="max-height:80px"/></div></t></t></t></template>
<record id="inspection_print" model="ir.actions.report"><field name="name">Inspection Report</field><field name="model">garage.inspection</field><field name="report_type">qweb-pdf</field><field name="report_name">garage_basic_reports.inspection_document</field><field name="binding_model_id" ref="garage_workshop.model_garage_inspection"/></record>
<template id="inspection_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2 t-field="o.template_id"/><p>Job: <span t-field="o.job_id"/></p><p>Phase: <span t-field="o.phase"/></p><table class="table"><thead><tr><th>Check</th><th>Required</th><th>Result</th><th>Remarks</th><th>Photo</th></tr></thead><tbody><tr t-foreach="o.line_ids" t-as="l"><td><span t-field="l.name"/></td><td><span t-field="l.mandatory"/></td><td><span t-field="l.result"/></td><td><span t-field="l.remarks"/></td><td><img t-if="l.photo" t-att-src="image_data_uri(l.photo)" style="max-height:100px"/></td></tr></tbody></table><p>Signed by <span t-field="o.signed_by"/> on <span t-field="o.signed_at"/></p></div></t></t></t></template>
</odoo>

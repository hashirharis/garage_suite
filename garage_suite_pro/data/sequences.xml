<odoo noupdate="1">
    <record id="sequence_contract" model="ir.sequence">
        <field name="name">Garage Service Contract</field>
        <field name="code">garage.service.contract</field>
        <field name="prefix">CON/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False" />
    </record>
    <record id="sequence_purchase_request" model="ir.sequence">
        <field name="name">Garage Purchase Request</field>
        <field name="code">garage.purchase.request</field>
        <field name="prefix">PR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False" />
    </record>
    <record id="sequence_vehicle_transport" model="ir.sequence">
        <field name="name">Garage Vehicle Transport</field>
        <field name="code">garage.vehicle.transport</field>
        <field name="prefix">TRIP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False" />
    </record>
</odoo>

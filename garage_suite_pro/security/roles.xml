<odoo>
    <record id="privilege_pro" model="res.groups.privilege">
        <field name="name">Garage Suite Pro</field>
        <field name="category_id" ref="garage_core.module_category_garage" />
    </record>
    <record id="group_garage_planner" model="res.groups">
        <field name="name">Workshop Planner</field>
        <field name="privilege_id" ref="privilege_pro" />
        <field name="implied_ids" eval="[Command.link(ref('garage_core.group_garage_advisor'))]" />
    </record>
    <record id="group_garage_inventory" model="res.groups">
        <field name="name">Workshop Inventory</field>
        <field name="privilege_id" ref="privilege_pro" />
        <field name="implied_ids" eval="[Command.link(ref('garage_core.group_garage_storekeeper')), Command.link(ref('stock.group_stock_user'))]" />
    </record>
    <record id="group_garage_buyer" model="res.groups">
        <field name="name">Garage Buyer</field>
        <field name="privilege_id" ref="privilege_pro" />
        <field name="implied_ids" eval="[Command.link(ref('garage_core.group_garage_staff')), Command.link(ref('purchase.group_purchase_user'))]" />
    </record>
    <record id="group_garage_purchase_approver" model="res.groups">
        <field name="name">Garage Purchase Approver</field>
        <field name="privilege_id" ref="privilege_pro" />
        <field name="implied_ids" eval="[Command.link(ref('group_garage_buyer')), Command.link(ref('purchase.group_purchase_manager'))]" />
    </record>
    <record id="group_garage_coverage" model="res.groups">
        <field name="name">Claims and Contracts Manager</field>
        <field name="privilege_id" ref="privilege_pro" />
        <field name="implied_ids" eval="[Command.link(ref('garage_core.group_garage_advisor'))]" />
    </record>
    <record id="group_garage_executive" model="res.groups">
        <field name="name">Garage Executive Analytics</field>
        <field name="privilege_id" ref="privilege_pro" />
        <field name="implied_ids" eval="[Command.link(ref('garage_core.group_garage_owner'))]" />
    </record>
    <record id="group_garage_pro_manager" model="res.groups">
        <field name="name">Garage Pro Operations Manager</field>
        <field name="privilege_id" ref="privilege_pro" />
        <field name="implied_ids" eval="[Command.link(ref('garage_core.group_garage_manager')), Command.link(ref('group_garage_planner')), Command.link(ref('group_garage_inventory')), Command.link(ref('group_garage_coverage')), Command.link(ref('group_garage_executive'))]" />
    </record>
</odoo>

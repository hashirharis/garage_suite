<templates xml:space="preserve">
    <t t-name="garage_suite_pro.Dashboard">
        <div class="gs-dashboard gs-pro" t-att-aria-busy="state.loading ? 'true' : 'false'">
            <main class="gs-dashboard-content">
                <header class="gs-pro-header">
                    <div>
                        <p t-if="insight" class="gs-pro-company"><i class="fa fa-building-o me-2" aria-hidden="true"/><t t-out="insight.company"/></p>
                        <h1>Garage Suite Pro</h1>
                        <p t-if="workspace" class="gs-pro-role" t-out="workspace.role"/>
                    </div>
                    <div class="gs-pro-actions">
                        <button t-if="state.canCreate" type="button" class="btn gs-create" t-on-click="createJob"><i class="fa fa-plus me-2" aria-hidden="true"/>New job card</button>
                        <button type="button" class="btn gs-export" t-on-click="exportReports"><i class="fa fa-download me-2" aria-hidden="true"/>Export reports</button>
                        <button t-if="workspace?.key === 'planning' || workspace?.key === 'technician'" type="button" class="btn gs-export" t-on-click="openSchedule"><i class="fa fa-calendar me-2" aria-hidden="true"/>Schedule</button>
                    </div>
                </header>

                <div t-if="state.error" class="alert alert-danger mt-3" role="alert">
                    <t t-out="state.error"/>
                    <button type="button" class="btn btn-link" t-on-click="load">Try again</button>
                </div>
                <p t-if="state.loading and !state.payload" class="mt-3" role="status">Loading workshop overview…</p>

                <t t-if="insight and workspace">
                    <div class="gs-pro-toolbar">
                        <nav aria-label="Garage workspaces" class="gs-tabs">
                            <button t-foreach="state.payload.workspaces" t-as="entry" t-key="entry.key" type="button"
                                    t-att-aria-pressed="entry.key === state.workspace ? 'true' : 'false'" t-on-click="() => this.state.workspace = entry.key" t-out="entry.label"/>
                        </nav>
                        <div class="gs-filters">
                            <label for="gs-pro-period">Period</label>
                            <select id="gs-pro-period" class="form-select" t-on-change="changePeriod" t-att-value="state.period">
                                <option value="7">Last 7 days</option>
                                <option value="30">Last 30 days</option>
                                <option value="90">Last 90 days</option>
                                <option value="all">All time</option>
                            </select>
                            <button type="button" class="btn btn-outline-secondary" t-on-click="load" t-att-disabled="state.loading" aria-label="Refresh"><i class="fa fa-refresh" aria-hidden="true"/></button>
                        </div>
                    </div>

                    <t t-if="['management', 'billing', 'overview'].includes(workspace.key)">
                        <section class="gs-pro-scorecard" aria-label="Current company performance">
                            <button type="button" class="gs-pro-stat" t-on-click="() => this.open('garage.job.card', insight.reception_domain, 'Visits received')">
                                <span>Visits received</span><strong t-out="insight.received"/><small>Current company · selected period</small>
                            </button>
                            <button type="button" class="gs-pro-stat" t-on-click="() => this.open('garage.job.card', insight.closed_domain, 'Closed visits')">
                                <span>Closed visits</span><strong t-out="insight.closed"/><small>Of visits received in period</small>
                            </button>
                            <button type="button" class="gs-pro-stat" t-on-click="() => this.open('garage.job.card', insight.on_time_domain, 'On-time handovers')">
                                <span>On-time handover</span><strong t-out="insight.on_time_rate === null ? '—' : insight.on_time_rate + '%'"/><small>Closed visits with a promised date</small>
                            </button>
                            <button t-if="profit" type="button" class="gs-pro-stat gs-pro-stat-emphasis"
                                    t-on-click="() => this.openProfitability()">
                                <span>Workshop margin</span><strong t-out="measure(profit.margin)"/>
                                <small t-if="profit.margin_rate !== null"><t t-out="profit.margin_rate"/>% of net revenue</small>
                                <small t-else="">Net revenue less direct cost</small>
                            </button>
                        </section>

                        <section t-if="profit" class="gs-panel gs-pro-chart" aria-label="Workshop profitability trend">
                            <div class="gs-panel-heading">
                                <div><h2>Workshop profitability</h2><p>Current company · last 12 months by job reception</p></div>
                                <button type="button" class="btn btn-outline-secondary" t-on-click="() => this.openProfitability()">Profitability report</button>
                            </div>
                            <div class="gs-pro-chart-facts">
                                <span><i class="gs-pro-key gs-pro-revenue"/>Net revenue <strong t-out="measure(profit.revenue)"/></span>
                                <span><i class="gs-pro-key gs-pro-cost"/>Direct cost <strong t-out="measure(profit.cost)"/></span>
                                <small>Totals for selected period</small>
                            </div>
                            <div class="gs-pro-chart-scroll">
                                <div class="gs-pro-columns">
                                    <button type="button" t-foreach="profit.months" t-as="month" t-key="month.date"
                                            t-on-click="() => this.openProfitability(month.domain)"
                                            t-att-title="monthLabel(month.date) + ' · ' + measure(month.revenue) + ' / ' + measure(month.cost)">
                                        <span class="gs-pro-bar-pair" aria-hidden="true">
                                            <span class="gs-pro-revenue" t-att-style="columnStyle(month.revenue)"/>
                                            <span class="gs-pro-cost" t-att-style="columnStyle(month.cost)"/>
                                        </span>
                                        <span t-out="monthLabel(month.date)"/>
                                        <span class="visually-hidden">Net revenue <t t-out="measure(month.revenue)"/>, direct cost <t t-out="measure(month.cost)"/></span>
                                    </button>
                                </div>
                            </div>
                        </section>
                    </t>

                    <section t-if="workspace.key === 'billing' and state.payload.finance.length" class="gs-pro-scorecard mt-4" aria-label="Billing snapshot">
                        <button t-foreach="state.payload.finance" t-as="metric" t-key="metric.key" type="button" class="gs-pro-stat"
                                t-on-click="() => this.open(metric.model, metric.domain, metric.label)">
                            <span t-out="metric.label"/><strong t-out="measure(metric.value)"/><small t-out="metric.description"/>
                        </button>
                    </section>
                    <section class="gs-pro-work" aria-label="Role work queues">
                        <div class="gs-section-heading"><h2>Work queues</h2><span t-out="workspace.label"/></div>
                        <div class="gs-kpis">
                            <button t-foreach="workspace.cards" t-as="card" t-key="card.key" type="button"
                                    t-att-class="'gs-kpi gs-tone-' + card.tone" t-on-click="() => this.open(card.model, card.domain, card.label)">
                                <span class="gs-kpi-top"><i t-att-class="'fa ' + card.icon" aria-hidden="true"/><i class="fa fa-arrow-right gs-kpi-arrow" aria-hidden="true"/></span>
                                <strong t-out="card.count.toLocaleString()"/>
                                <span class="gs-kpi-label" t-out="card.label"/>
                                <span class="gs-kpi-bottom" t-out="card.description"/>
                            </button>
                        </div>
                    </section>
                    <div class="gs-pro-detail">
                        <section class="gs-panel gs-pro-pipeline">
                            <div class="gs-panel-heading"><div><h2>Visit pipeline</h2><p>Selected companies · selected period</p></div><span class="gs-total"><t t-out="state.payload.total"/> visits</span></div>
                            <button type="button" class="gs-stage" t-foreach="state.payload.pipeline" t-as="stage" t-key="stage.key"
                                    t-on-click="() => this.open('garage.job.card', stage.domain, stage.label)">
                                <span class="gs-stage-label"><span t-out="stage.label"/><strong t-out="stage.count"/></span>
                                <span class="gs-track" aria-hidden="true"><span t-att-class="'gs-fill gs-state-' + stage.key" t-att-style="'width:' + barWidth(stage.count)"/></span>
                            </button>
                        </section>
                        <section class="gs-panel">
                            <div class="gs-panel-heading"><div><h2>Recent job cards</h2><p>Selected companies · selected period</p></div>
                                <button type="button" class="btn btn-link" t-on-click="() => this.open('garage.job.card', state.payload.visit_domain, 'Job Cards')">View all</button>
                            </div>
                            <p t-if="!state.payload.recent.length" class="gs-empty">No visits match this period.</p>
                            <div t-else="" class="gs-table-wrap">
                                <table class="table">
                                    <thead><tr><th>Job card</th><th>Vehicle</th><th>Expected delivery</th><th>Status</th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="state.payload.recent" t-as="job" t-key="job.id">
                                            <td><button type="button" class="gs-record-link" t-on-click="() => this.openJob(job.id)" t-out="job.name"/></td>
                                            <td t-out="job.vehicle"/><td t-out="date(job.expected_delivery)"/>
                                            <td><span t-att-class="'gs-badge gs-badge-' + job.state_key" t-out="job.state"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    </div>
                </t>
            </main>
        </div>
    </t>
</templates>
